{
  "name": "tk-content-growth-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --config vite.config.js --host 0.0.0.0\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --config vite.config.js --host 0.0.0.0",
    "build": "tsc -b && vite build --config vite.config.js",
    "preview": "vite preview --config vite.config.js --host 0.0.0.0",
    "db:generate": "prisma generate",
    "db:push": "prisma generate && tsx server/db-init.ts",
    "db:seed": "tsx server/db-init.ts",
    "setup": "npm install && npm run db:push && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.38",
    "prisma": "^6.9.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
